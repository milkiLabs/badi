[Unit]
Description=Badi shell (top bar + on-demand launcher)
Documentation=https://github.com/milkiLabs/badi
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Long-lived shell: top bar always visible, launcher hidden until `badi --launcher`
# (or `something | badi --launcher`) asks over the runtime-dir socket. The daemon owns
# no stdio, so stdio here is only for crash logs.
ExecStart=/usr/bin/badi
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
